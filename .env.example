# SafeHaven Checkout uses these values in the browser, so do not put an OAuth
# client secret or any other private credential in a NEXT_PUBLIC_ variable.
NEXT_PUBLIC_SAFEHAVEN_ENVIRONMENT=sandbox
NEXT_PUBLIC_SAFEHAVEN_CLIENT_ID=your_oauth_client_id
NEXT_PUBLIC_SAFEHAVEN_BANK_CODE=999240
NEXT_PUBLIC_SAFEHAVEN_ACCOUNT_NUMBER=your_10_digit_safehaven_account
NEXT_PUBLIC_SAFEHAVEN_FEE_BEARER=customer

# Optional HTTPS endpoint that receives SafeHaven payment notifications.
NEXT_PUBLIC_SAFEHAVEN_WEBHOOK_URL=
